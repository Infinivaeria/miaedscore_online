#!/usr/bin/env sh
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
target=wasm32-unknown-unknown
wasm="$root/wasm-client/target/$target/release/midscore_wasm_client.wasm"
key=/etc/letsencrypt/live/miaedscore.online/privkey.pem
cert=/etc/letsencrypt/live/miaedscore.online/fullchain.pem

if [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'HTTPS on port 443 requires root or the CAP_NET_BIND_SERVICE capability.' >&2
  exit 1
fi

if ! rustup target list --installed | grep -qx "$target"; then
  printf '%s\n' "Missing Rust target. Run: rustup target add $target" >&2
  exit 1
fi

if [ ! -r "$key" ] || [ ! -r "$cert" ]; then
  printf '%s\n' "TLS certificate files are unreadable: $key or $cert" >&2
  exit 1
fi

cd "$root"
cargo build --manifest-path wasm-client/Cargo.toml --target "$target" --release
mkdir -p public/assets
cp "$wasm" public/assets/midscore_moon.wasm

if [ -s config/puma.pid ] && kill -0 "$(cat config/puma.pid)" 2>/dev/null; then
  bundle exec pumactl -S config/puma.state stop
fi

nohup bundle exec puma -C config/puma.rb </dev/null >/dev/null 2>&1 &
printf '%s\n' 'Puma is starting in the background at https://miaedscore.online/.'