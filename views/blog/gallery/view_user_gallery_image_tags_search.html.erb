<style>
    .image {
        border: 1px solid white;
        overflow: auto;
        width: 50%;
        height: 50%;
        float: left;
        box-sizing: border-box;
    }

    .tag-search-help {
        max-width: 42rem;
        margin: 0.75rem auto;
        padding: 0 0.75rem;
        text-align: left;
    }

    @media screen and (max-width: 768px) {
        .image {
            width: 100%;
            height: auto;
            float: none;
        }
    }
</style>
<center><form action="<%= "#{domain_name(@r)}/gallery/view/#{@user}/tags/search" %>" method="get">
    <input type="text" id="search_tags" name="search_tags" placeholder="Search tags" required> <a href="<%= "#{domain_name(@r)}/gallery/view/#{@user}/tags/" %>">(🏷️,🏷️,...)</a>
    <input type="submit" value="Search">
</form>
</center>
<details class="tag-search-help" open>
    <summary>Tag search options</summary>
    <p>Separate terms with commas. Matching is case-sensitive.</p>
    <ul>
        <li><code>red, ++blue</code>: require both tags. The <code>++</code> prefix is optional.</li>
        <li><code>--green</code>: exclude images with this tag.</li>
        <li><code>||blue, ||green</code>: require at least one of these tags.</li>
        <li><code>\||blue</code>: search for a literal tag beginning with an operator. This also works for <code>\++</code> and <code>\--</code>.</li>
    </ul>
</details>
<% if !@only_search %>
    <br>
    <br>
    <h1>For <%= @user %>'s tags: <%= parse_tags(user: @user, tag_string: @search_params) %></h1> <!-- todo: work on tag version of tags list (this) -->
    
    <h2><% (@search_params_set | @any_tags).each do |tag| %>            
            <% if @similar_tags_set.dig(tag) %>            
               <%= parse_tags(user: @user, tag_string: @similar_tags_set[tag].join(', ')) %>
            <% end %>
        <% end %>
    </h2>

    
    <div class="image-container">
        <% @images_to_find.each do |image| %>
            <% next if image.nil? %>
            <div class="image">
                <p><strong>(🧾)</strong> <%= image['title'] %></p>
                <p><strong>(🆔)</strong> <%= image['id'] %></p>
                <p><strong>(🏷️)</strong> <%= parse_tags(user: @user, tag_string: image["tags"], r: @r) %></p>
                <p><strong>(⌚)</strong> <%= image['date'] %></p>
                <p><strong>(♾️)</strong> <%= image['views'] %></p>
                <p><strong>(🖼️)</strong> <a href="<%= "#{domain_name(@r)}/gallery_index/#{@user}/#{image['file']}" %>">(⏬➡️💾)</a></p>
                <p><strong>(🔗)</strong> <a href="<%= "#{domain_name(@r)}/gallery/view/#{@user}/id/#{image['id']}" %>"><img src="<%= "#{domain_name(@r)}/gallery_index/#{@user}/thumbnail_#{image['file']}" %>" alt="<%= @title %>"></a></p>
                <p><strong>(📌)</strong> <a href="<%= "#{domain_name(@r)}/gallery/edit/#{@user}/id/#{image['id']}" %>">(📝)</a></p>
            </div>
        <% end %>
    </div>
    <br>
    <center>Back to <a href="<%= "#{domain_name(@r)}/gallery/view/#{@user}" %>">Gallery</a> | Back to <a href="<%= "#{domain_name(@r)}/gallery/view/#{@user}/tags" %>">Tags</a></center>
<% end %>
